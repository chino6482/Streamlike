# =============================================================
# StreamLike - Variables de entorno (ejemplo)
# =============================================================
# Copia este archivo a `.env` y ajusta los valores:
#   cp .env.example .env
# Las credenciales de abajo son SOLO para desarrollo local con
# docker compose (postgres/redis/localstack incluidos).
# =============================================================

# --- PostgreSQL ---
DATABASE_URL=postgresql://streamlike:secret@postgres:5432/streamlike

# --- Redis (cola BullMQ) ---
REDIS_URL=redis://redis:6379

# --- S3 (LocalStack en desarrollo; en producción: AWS real) ---
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_ENDPOINT=http://localstack:4566
S3_BUCKET=streamlike-bucket

# --- API / Web ---
# URL pública de la API que usa el navegador (se incrusta en build-time del web)
NEXT_PUBLIC_API_URL=http://localhost:3000

# --- Autenticación opcional por API key ---
# Si defines API_KEY, la API exigirá la cabecera `x-api-key` y el frontend la
# enviará. Al activarlo hay que reconstruir el contenedor web:
#   docker compose build web && docker compose up -d web
# API_KEY=dev-secret-key
# NEXT_PUBLIC_API_KEY=dev-secret-key
