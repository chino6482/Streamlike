# ---- Base de datos y cola (Docker Compose / producción) ----
DATABASE_URL=
REDIS_URL=

# ---- Servidor API ----
PORT=3000
API_KEY=

# ---- Almacenamiento S3 (LocalStack, Cloudflare R2, Supabase Storage o AWS S3) ----
# LocalStack (desarrollo):
#   AWS_REGION=us-east-1 (o auto)
#   S3_ENDPOINT=http://localstack:4566
#   S3_PUBLIC_ENDPOINT=http://localhost:4566
#   S3_BUCKET=streamlike-bucket
#
# Cloudflare R2 (producción):
#   AWS_REGION=auto
#   S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   S3_PUBLIC_ENDPOINT=https://pub-<PUBLIC_HASH>.r2.dev
#   S3_BUCKET=<TU_BUCKET_R2>
#
# Supabase Storage S3 (producción):
#   AWS_REGION=<TU_REGION_SUPABASE>
#   S3_ENDPOINT=https://<PROJECT_REF>.supabase.co/storage/v1/s3
#   S3_PUBLIC_ENDPOINT=https://<PROJECT_REF>.supabase.co/storage/v1/object/public/<TU_BUCKET>
#   S3_BUCKET=<TU_BUCKET>
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto
S3_BUCKET=
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_FORCE_PATH_STYLE=true

# ---- Inteligencia Artificial (Gemini 3 + modo BYOK) ----
# Opcional en el servidor: los usuarios pueden introducir su propia Gemini API Key
# desde "Configuración de API Keys" en la web (se guarda en localStorage y viaja
# en la cabecera HTTP x-gemini-key sin almacenarse en PostgreSQL).
# Si no se configura clave ni en el navegador ni aquí, el worker usa ebur128 + escenas.
GEMINI_API_KEY=

# ---- Frontend Next.js (build-time en Docker) ----
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_API_KEY=

# ---- Descarga con yt-dlp (cookies opcionales para YouTube) ----
YOUTUBE_COOKIES=
YTDLP_COOKIES_PATH=