{
  "name": "streamlike-monorepo",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "dev:web": "npm --workspace=@streamlike/web dev",
    "dev:api": "npm --workspace=@streamlike/api dev",
    "dev:worker": "npm --workspace=@streamlike/worker dev",
    "build": "npm run build --workspace=apps/web",
    "start": "npm run start --workspace=apps/web",
    "build:web": "npm --workspace=@streamlike/web build",
    "build:api": "npm --workspace=@streamlike/api build",
    "build:worker": "npm --workspace=@streamlike/worker build",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:baseline": "prisma migrate resolve --applied 0_init"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "prisma": "^5.22.0"
  },
  "dependencies": {
    "@google/genai": "^3.4.0"
  }
}
